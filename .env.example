# Required Vite client env (public / publishable only — never put service-role keys here).
#
# Local + testing: values live in committed `.env.testing` (`npm run dev` uses `--mode testing`).
# Personal overrides: copy keys into `.env.local` (gitignored).
# Production / deploy builds: `scripts/build-spa.sh` writes a gitignored `.env.production`
# from Terraform outputs (or CI env). Do not commit `.env.production`.

# Supabase — Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site hostname shown on legal pages (privacy, etc.)
# Local/testing: beta.coursewright.com · Production: coursewright.com
VITE_PUBLIC_HOST=coursewright.com

# hCaptcha — publishable site key for Supabase Auth (same on all tiers)
VITE_HCAPTCHA_SITE_KEY=

# PostHog — production only (leave empty for local/testing; SPA no-ops)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
