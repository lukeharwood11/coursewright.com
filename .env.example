# Required Vite client env (public / publishable only — never put service-role keys here).
#
# Local + testing: values live in committed `.env.development` (loaded by `npm run dev`).
# Personal overrides: copy keys into `.env.local` (gitignored).
# Production builds: set these in CI / hosting, not in a committed `.env.production`.

# Supabase — Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog — Project settings
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
